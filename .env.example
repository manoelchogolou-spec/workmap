# =========================================================
# Configuration WorkMap
# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être versionné.
# =========================================================

# development | production
NODE_ENV=development

# Port d'écoute du serveur
PORT=3000

# Chemin de la base SQLite (absolu ou relatif à la racine)
# Laisser vide pour utiliser db/workmap.sqlite
DB_PATH=

# --- Sessions --------------------------------------------
SESSION_COOKIE_NAME=wm_sid
SESSION_DURATION_DAYS=7

# --- Mots de passe ---------------------------------------
# Minimum 12 en production
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10

# --- Fonctionnalités -------------------------------------
# true  : n'importe qui peut créer un compte contributeur
# false : inscription fermée (403)
REGISTRATION_OPEN=true

# --- Amorçage du premier administrateur ------------------
# Utilisé uniquement par : npm run bootstrap-admin
# Laisser vide en développement (le seed fournit déjà un admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=WorkMap